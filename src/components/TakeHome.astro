---
import type { Content } from '../data/content';
import SmartImage from './ui/SmartImage.astro';

interface Props {
  c: Content;
}
const { c } = Astro.props;
const t = c.takeHome;
const icons = [
  'M8 3h8v3l2 3v12H6V9l2-3zM6 12h12', // bottle
  'M6 7h12l-1 13H7zM9 7a3 3 0 0 1 6 0', // bag
  'M7 3h10v18H7zM10 18h4', // phone
];
---

<section class="relative bg-paper py-24 text-ink md:py-32" aria-labelledby="take-title">
  <div class="container-x grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-10">
    <div class="lg:col-span-6">
      <p class="t-wide text-cobalt" data-reveal>{t.eyebrow}</p>
      <h2 id="take-title" class="t-serif t-h2 mt-5" data-reveal>{t.title}</h2>
      <ul class="mt-12 grid gap-0 border-t border-line-light">
        {
          t.items.map((it, i) => (
            <li class="flex gap-5 border-b border-line-light py-6" data-reveal>
              <svg class="mt-1 h-7 w-7 shrink-0 text-cobalt" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
                <path d={icons[i]} />
              </svg>
              <div>
                <h3 class="font-bold">{it.title}</h3>
                <p class="t-body mt-1 text-ink/65">{it.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="lg:col-span-5 lg:col-start-8" data-reveal>
      <div class="aspect-square overflow-hidden rounded-[2rem] bg-bone">
        <div class="h-full w-full" data-drift>
          <SmartImage name="beans-bag" alt="" sizes="(min-width: 1024px) 36vw, 92vw" />
        </div>
      </div>
    </div>
  </div>
</section>
