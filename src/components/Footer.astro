---
import type { Lang } from '../data/site';
import { site, pathFor } from '../data/site';
import type { Content } from '../data/content';
import Wordmark from './Wordmark.astro';

interface Props {
  lang: Lang;
  c: Content;
}
const { lang, c } = Astro.props;
const other = c.nav.switchLang;
---

<footer class="overflow-hidden border-t border-line-dark bg-ink pt-20">
  <div class="container-x grid gap-10 md:grid-cols-12">
    <p class="t-serif text-[clamp(1.8rem,3vw,2.6rem)] leading-tight md:col-span-6 rtl:leading-[1.6]">{c.footer.tagline}</p>
    <nav aria-label={c.nav.label} class="flex flex-col gap-3 md:col-span-3 md:col-start-8">
      {c.nav.links.map((l) => <a href={l.href} class="text-paper/70 hover:text-paper">{l.label}</a>)}
    </nav>
    <div class="flex flex-col gap-3 md:col-span-2">
      <a href={site.orderUrl} target="_blank" rel="noopener" class="text-paper/70 hover:text-paper">Talabat</a>
      <a href={site.driveThruUrl} target="_blank" rel="noopener" class="text-paper/70 hover:text-paper">Drivu</a>
      <a href={site.instagram} target="_blank" rel="noopener" class="text-paper/70 hover:text-paper" dir="ltr">{site.instagramHandle}</a>
      <a href={pathFor(other)} hreflang={other} lang={other} class="text-paper/70 hover:text-paper" data-lang-switch>{c.nav.switchLabelFull}</a>
    </div>
  </div>

  <a href="#top" aria-label={c.footer.top} class="mt-20 flex justify-center text-paper" data-reveal>
    <Wordmark size="lg" />
  </a>

  <div class="container-x mt-12 flex flex-col gap-2 border-t border-line-dark py-6 text-[0.85rem] text-stone md:flex-row md:justify-between">
    <p>{c.footer.rights}</p>
    {site.isConcept && <p>{c.footer.conceptNote}</p>}
  </div>
</footer>
