---
import type { Content } from '../data/content';

interface Props {
  c: Content;
}
const { c } = Astro.props;
const r = c.ritual;
---

<section id="ritual" class="relative overflow-hidden bg-cobalt py-24 text-white md:py-36" aria-labelledby="ritual-title" data-ritual>
  <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <p class="t-wide text-white/70" data-reveal>{r.eyebrow}</p>
      <h2 id="ritual-title" class="t-serif t-h2 mt-5" data-reveal>{r.title}</h2>
    </div>

    <ol class="relative lg:col-span-6 lg:col-start-7">
      <!-- progress line -->
      <span class="absolute bottom-3 start-[7px] top-3 w-px bg-white/25" aria-hidden="true"></span>
      <span class="absolute bottom-3 start-[7px] top-3 w-px origin-top bg-white" aria-hidden="true" data-ritual-line></span>
      {
        r.steps.map((s) => (
          <li class="relative ps-14 pb-14 last:pb-0" data-ritual-step>
            <span class="absolute start-0 top-2 h-[15px] w-[15px] rounded-full border-2 border-white bg-cobalt" aria-hidden="true" />
            <p class="t-num text-[clamp(2.4rem,5vw,4rem)] leading-none" dir="ltr">{s.time}</p>
            <h3 class="t-wide mt-4 text-white">{s.title}</h3>
            <p class="t-body mt-2 max-w-md text-white/80">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
